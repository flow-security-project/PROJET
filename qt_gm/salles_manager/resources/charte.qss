* {
    font-family: "Inter", "Open Sans", "Segoe UI", "Helvetica Neue", "DejaVu Sans", sans-serif;
    font-size: 13px;
    color: #1A1A1A;
}

QMainWindow, QWidget#sallesRoot {
    background-color: #FFFFFF;
    color: #1A1A1A;
}

QWidget#sallesRoot QWidget {
    background-color: #FFFFFF;
    color: #1A1A1A;
}

QScrollArea#sallesScroll {
    background: #FFFFFF;
    border: none;
}

QScrollArea#sallesScroll QWidget {
    background: #FFFFFF;
}

QScrollBar:vertical {
    background: #F5F5F5;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #D0D0D0;
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #BDBDBD;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F5F5F5;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #D0D0D0;
    border-radius: 2px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolBar {
    background: #F5F5F5;
    border: none;
    border-bottom: 1px solid #D0D0D0;
    spacing: 6px;
    padding: 4px;
}

QLineEdit, QSpinBox, QTimeEdit, QComboBox {
    background: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    padding: 5px 8px;
}

QLineEdit:focus, QSpinBox:focus, QTimeEdit:focus, QComboBox:focus {
    border-color: #4A90D9;
}

QLineEdit:read-only {
    background: #F5F5F5;
    color: #555555;
}

QPushButton {
    background: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background: #FAFAFA;
    border-color: #4A90D9;
}

QPushButton:pressed {
    background: #EEEEEE;
}

QPushButton:disabled {
    color: #999999;
    border-color: #E0E0E0;
    background: #FAFAFA;
}

QGroupBox {
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    margin-top: 10px;
    padding: 8px;
    background: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    font-weight: 600;
}

QSplitter::handle {
    background: #D0D0D0;
}

QPlainTextEdit#journal {
    background: #FFFFFF;
    border: 1px solid #D0D0D0;
    color: #555555;
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
}

QFrame#salleCard {
    background-color: #FFFFFF;
    border: 2px solid #D0D0D0;
    border-radius: 6px;
}

QFrame#salleCard:hover {
    border: 2px solid #4A90D9;
    background-color: #FAFAFA;
}

QFrame#salleCard[selected="true"] {
    border: 2.5px solid #1565C0;
    background-color: #E3F2FD;
}

QFrame#salleCard[level="offline"] {
    background-color: #F8F9FA;
    border: 2px solid #D0D0D0;
}

QFrame#salleCard[level="critical"] {
    border: 2.5px solid #D32F2F;
    background-color: #FFEBEE;
}

QLabel#cardTitle {
    font-size: 16px;
    font-weight: 700;
    color: #1A1A1A;
}

QLabel#cardTag {
    font-size: 12px;
    font-weight: 600;
    color: #444444;
    background-color: #EAEAEA;
    border-radius: 3px;
    padding: 2px 5px;
}

QLabel#cardStatusBadge {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
}

QLabel#cardStatusBadge[level="normal"] {
    color: #2E7D32;
    background-color: #E8F5E9;
}

QLabel#cardStatusBadge[level="warning"] {
    color: #E65100;
    background-color: #FFF3E0;
}

QLabel#cardStatusBadge[level="critical"] {
    color: #C62828;
    background-color: #FFCDD2;
}

QLabel#cardStatusBadge[level="offline"] {
    color: #616161;
    background-color: #EEEEEE;
}

QLabel#cardStatusBadge[level="pending"] {
    color: #0277BD;
    background-color: #E1F5FE;
}

QLabel#cardOccupancyNum {
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 24px;
    font-weight: 700;
    color: #1A1A1A;
}

QLabel#cardPercentBadge {
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 15px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
}

QLabel#cardPercentBadge[level="normal"] {
    color: #2E7D32;
    background-color: #E8F5E9;
}

QLabel#cardPercentBadge[level="warning"] {
    color: #E65100;
    background-color: #FFF3E0;
}

QLabel#cardPercentBadge[level="critical"] {
    color: #C62828;
    background-color: #FFCDD2;
}

QLabel#cardPercentBadge[level="offline"], QLabel#cardPercentBadge[level="pending"] {
    color: #616161;
    background-color: #EEEEEE;
}

QProgressBar#cardProgressBar {
    background-color: #E0E0E0;
    border: none;
    border-radius: 4px;
}

QProgressBar#cardProgressBar::chunk {
    border-radius: 4px;
}

QProgressBar#cardProgressBar[level="normal"]::chunk {
    background-color: #4CAF50;
}

QProgressBar#cardProgressBar[level="warning"]::chunk {
    background-color: #FF9800;
}

QProgressBar#cardProgressBar[level="critical"]::chunk {
    background-color: #F44336;
}

QProgressBar#cardProgressBar[level="offline"]::chunk, QProgressBar#cardProgressBar[level="pending"]::chunk {
    background-color: #9E9E9E;
}

QLabel#cardMetric {
    font-size: 12px;
    font-weight: 600;
    color: #222222;
}

QLabel#cardMetricSub {
    font-size: 12px;
    color: #555555;
}

QLabel#statusLabel {
    color: #555555;
    font-size: 12px;
    padding: 4px 2px;
}

QLabel#errorLabel {
    color: #C62828;
    font-size: 11px;
}

QLabel#successLabel {
    color: #2E7D32;
    font-size: 11px;
}
