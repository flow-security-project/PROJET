/* ============================================================
   i++ — Charte graphique « SpaceX / xAI Obsidian »
   Design system : Fond noir profond obsidienne, surfaces sombres,
   typographies techniques, accents vert émeraude / ambre / rouge,
   absence de bandeaux latéraux IA, esthétique cockpits & télémétrie.
   ============================================================ */

/* ---------- Base Globale ---------- */
* {
    font-family: "Space Grotesk", "JetBrains Mono", "DIN Next LT Pro", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #F0F6FC;
    selection-background-color: #10B981;
    selection-color: #080B10;
}

QMainWindow, QDialog {
    background-color: #080B10;
}

/* ---------- Fenêtres & Panneaux Principaux ---------- */
QWidget#sallesRoot, QWidget#stadeRoot, QWidget#detailRoot {
    background-color: #080B10;
}

QWidget#sallesLeft {
    background-color: transparent;
}

QWidget#sallesLeft QScrollArea {
    background: transparent;
    border: none;
}

QLabel#pageTitle {
    font-family: "Space Grotesk", "DIN Next LT Pro", sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #F0F6FC;
    padding: 6px 4px 10px 4px;
    text-transform: uppercase;
}

QLabel#statusLabel {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #8B949E;
}

/* ---------- Barre d'Outils Cockpit ---------- */
QToolBar {
    background-color: #0D1117;
    border: none;
    border-bottom: 1px solid #1F293D;
    spacing: 10px;
    padding: 6px 14px;
}

QToolBar QLabel {
    color: #8B949E;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------- Champs de Saisie & Selecteurs ---------- */
QLineEdit, QSpinBox, QTimeEdit, QDateTimeEdit, QComboBox {
    background-color: #111622;
    border: 1px solid #212B3E;
    border-radius: 4px;
    padding: 5px 10px;
    color: #F0F6FC;
    font-family: "JetBrains Mono", monospace;
}

QLineEdit:hover, QSpinBox:hover, QTimeEdit:hover, QDateTimeEdit:hover, QComboBox:hover {
    border-color: #354563;
    background-color: #151C2C;
}

QLineEdit:focus, QSpinBox:focus, QTimeEdit:focus, QDateTimeEdit:focus, QComboBox:focus {
    border: 1px solid #10B981;
    background-color: #121826;
}

QLineEdit:read-only {
    background-color: #0B0E14;
    color: #6E7681;
    border-color: #181E2B;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #080B10;
    color: #484F58;
    border-color: #161B26;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8B949E;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #0E131F;
    border: 1px solid #212B3E;
    border-radius: 4px;
    selection-background-color: #047857;
    selection-color: #10B981;
    padding: 4px;
}

QSpinBox::up-button, QSpinBox::down-button,
QDateTimeEdit::up-button, QDateTimeEdit::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

/* ---------- Boutons Haute Performance ---------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #151C2B, stop:1 #0F1420);
    border: 1px solid #212B3E;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 600;
    color: #E6EDF3;
    letter-spacing: 0.3px;
}

QPushButton:hover {
    background: #047857;
    border-color: #10B981;
    color: #F0F6FC;
}

QPushButton:pressed {
    background: #065F46;
    border-color: #059669;
}

QPushButton:disabled {
    color: #484F58;
    background: #0B0E14;
    border-color: #161B26;
}

/* Bouton Action Primaire (Vert Émeraude Lumineux) */
QPushButton#btnPrimaire {
    background: #10B981;
    color: #05080C;
    border: none;
    padding: 7px 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QPushButton#btnPrimaire:hover {
    background: #34D399;
}

QPushButton#btnPrimaire:pressed {
    background: #059669;
}

QPushButton#btnPrimaire:disabled {
    background: #064E3B;
    color: #047857;
}

/* Bouton Spécifique Actions Historique & Export */
QPushButton#btnChargerHistorique:hover,
QPushButton#btnExporterSalleCsv:hover,
QPushButton#btnExporterSallePdf:hover,
QPushButton#btnExporterAlertes:hover,
QPushButton#btnAcquitter:hover,
QPushButton#btnVoirAlerte:hover {
    background: #047857;
    border-color: #10B981;
    color: #F0F6FC;
}

/* Bouton Danger / Supprimer */
QPushButton#btnSupprimer {
    background: #241215;
    border: 1px solid #5C1D24;
    color: #F87171;
}

QPushButton#btnSupprimer:hover {
    background: #3B181C;
    border-color: #EF4444;
    color: #FFFFFF;
}

/* ---------- Groupes & Cartes de Configuration ---------- */
QGroupBox {
    border: 1px solid #1E2738;
    border-radius: 6px;
    margin-top: 14px;
    padding: 12px 14px 14px 14px;
    background-color: #0D1118;
    font-weight: 700;
    color: #F0F6FC;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #10B981;
    background-color: #080B10;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QGroupBox#kpiCard {
    border: 1px solid #1F293D;
    border-radius: 6px;
    margin-top: 0;
    padding: 0;
    background-color: #0E131F;
}

QGroupBox#kpiCard:hover {
    border-color: #2D3B56;
}

QWidget#configRoot {
    background-color: #0D1118;
    border: 1px solid #1E2738;
    border-radius: 8px;
}

QLabel#configTitle {
    font-size: 15px;
    font-weight: 700;
    color: #F0F6FC;
    letter-spacing: 0.5px;
}

QGroupBox#configCard QLabel,
QGroupBox#actionCard QLabel,
QGroupBox#restoreCard QLabel {
    color: #8B949E;
    font-size: 12px;
    font-weight: 500;
}

/* ---------- Splitter & Séparateurs ---------- */
QSplitter::handle {
    background: #141A26;
}

QSplitter::handle:hover {
    background: #10B981;
}

QSplitter::handle:horizontal {
    width: 3px;
}

/* ---------- Barres de Défilement Minimalistes ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #1F283B;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #10B981;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 7px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #1F283B;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #10B981;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ============================================================
   CARTES DE SALLE (STYLE SPACEX OBSIDIAN - SANS BANDE LATERALE)
   ============================================================ */

QFrame#salleCard, QFrame#stadeSalleCard {
    background-color: #0E131F;
    border: 1px solid #1E2738;
    border-radius: 6px;
}

QFrame#salleCard:hover, QFrame#stadeSalleCard:hover {
    border: 1px solid #10B981;
    background-color: #101923;
}

QFrame#salleCard[selected="true"], QFrame#stadeSalleCard[selected="true"] {
    border: 1.5px solid #10B981;
    background-color: #122220;
}

QFrame#salleCard[level="offline"] {
    background-color: #0A0D14;
    border-color: #161C28;
}

QFrame#salleCard[level="warning"] {
    border-color: #78350F;
}

QFrame#salleCard[level="critical"] {
    border-color: #7F1D1D;
    background-color: #140B0E;
}

/* Cartes de Stade (Vue UNI-MARKET) */
QFrame#stadeCard {
    background-color: #0E1715;
    border: 1px solid #059669;
    border-radius: 6px;
}

QFrame#stadeCard:hover {
    border-color: #10B981;
    background-color: #11201D;
}

QFrame#stadeCard[selected="true"] {
    border: 2px solid #10B981;
    background-color: #142824;
}

/* Composants Internes de Carte */
QWidget#cardBody {
    background: transparent;
}

QLabel#cardTitle {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #F0F6FC;
}

QLabel#cardTag {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #6E7681;
}

/* LED d'État Télémétrique (Point discret) */
QLabel#cardLed {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #484F58;
}

QLabel#cardLed[level="normal"] {
    background-color: #10B981;
}

QLabel#cardLed[level="warning"] {
    background-color: #F59E0B;
}

QLabel#cardLed[level="critical"] {
    background-color: #EF4444;
}

QLabel#cardLed[level="pending"] {
    background-color: #059669;
}

QLabel#cardLed[level="offline"] {
    background-color: #484F58;
}

/* Badges de Statut Technologiques */
QLabel#cardStatusBadge {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    background-color: #161D2B;
    color: #8B949E;
    border: 1px solid #232D42;
}

QLabel#cardStatusBadge[level="normal"] {
    background-color: #064E3B;
    color: #34D399;
    border: 1px solid #059669;
}

QLabel#cardStatusBadge[level="warning"] {
    background-color: #451A03;
    color: #FBBF24;
    border: 1px solid #D97706;
}

QLabel#cardStatusBadge[level="critical"] {
    background-color: #450A0A;
    color: #F87171;
    border: 1px solid #DC2626;
}

QLabel#cardStatusBadge[level="pending"] {
    background-color: #064E3B;
    color: #34D399;
    border: 1px solid #059669;
}

QLabel#cardStatusBadge[level="offline"] {
    background-color: #161B26;
    color: #6E7681;
    border: 1px solid #21293A;
}

/* Chiffres d'Occupation Télémétriques (Vert Émeraude Lumineux) */
QLabel#cardOccupancyNum {
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    font-size: 22px;
    color: #10B981;
}

QLabel#cardPercent {
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    font-size: 14px;
    color: #8B949E;
}

QLabel#cardPercent[level="normal"] { color: #34D399; }
QLabel#cardPercent[level="warning"] { color: #FBBF24; }
QLabel#cardPercent[level="critical"] { color: #F87171; }

/* Jauge de Progression de Carte */
QProgressBar#cardProgressBar {
    background-color: #141A26;
    border: 1px solid #1F283A;
    border-radius: 2px;
}

QProgressBar#cardProgressBar::chunk {
    background-color: #10B981;
    border-radius: 1px;
}

QProgressBar#cardProgressBar[level="normal"]::chunk { background-color: #10B981; }
QProgressBar#cardProgressBar[level="warning"]::chunk { background-color: #F59E0B; }
QProgressBar#cardProgressBar[level="critical"]::chunk { background-color: #EF4444; }

/* Footer de Carte */
QFrame#cardFooter {
    background-color: #0B0E15;
    border: 1px solid #171E2C;
    border-radius: 4px;
}

QLabel#cardMetric {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #8B949E;
}

QLabel#cardMetricSub {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #6E7681;
}

/* ---------- Détails de Salle & KPIs ---------- */
QLabel#detailTitle {
    font-family: "Space Grotesk", sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #F0F6FC;
    letter-spacing: 0.5px;
}

QLabel#detailStatusBadge {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 3px;
}

QLabel#kpiTitle {
    font-family: "Space Grotesk", sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #8B949E;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* Métriques Principales en Vert Émeraude Lumineux #10B981 */
QLabel#kpiValue {
    font-family: "JetBrains Mono", monospace;
    font-size: 20px;
    font-weight: 700;
    color: #10B981;
}

/* Sorties en Orange Chaud #F57C00 */
QLabel#kpiValue[kpiType="sorties"] {
    color: #F59E0B;
}

QLabel#detailInfos {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #8B949E;
    background-color: #0E131F;
    border: 1px solid #1E2738;
    border-radius: 4px;
    padding: 8px 12px;
}

/* Badges d'Alerte */
QLabel#alerteFluxBadge, QLabel#alerteIntrusionBadge {
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 14px;
    border-radius: 4px;
    color: #FFFFFF;
    background-color: #7F1D1D;
    border: 1px solid #EF4444;
}

/* ---------- Panneau d'Alertes ---------- */
QWidget#panelAlertesRoot {
    background-color: #0D1118;
    border: 1px solid #1E2738;
    border-radius: 8px;
}

QListWidget#alertesList {
    background-color: #080B10;
    border: 1px solid #1E2738;
    border-radius: 4px;
}

QListWidget#alertesList::item {
    background-color: #0E131F;
    border: 1px solid #19202E;
    border-radius: 4px;
    margin: 3px 0;
    padding: 6px;
    color: #F0F6FC;
}

QListWidget#alertesList::item:hover {
    border-color: #10B981;
    background-color: #101B18;
}

/* CheckBox Modernes Cockpit */
QCheckBox {
    font-size: 12px;
    font-weight: 600;
    color: #C9D1D9;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #2B364E;
    border-radius: 3px;
    background-color: #111622;
}

QCheckBox::indicator:hover {
    border-color: #10B981;
}

QCheckBox::indicator:checked {
    background-color: #10B981;
    border-color: #10B981;
}

