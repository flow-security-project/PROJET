/* ============================================================
   i++ v4.0 — Charte graphique "Corporate Engineering"
   Conforme a Charte_Graphique.md (mode clair obligatoire)
   ============================================================ */

* {
    font-family: "Inter", "Segoe UI", "Helvetica Neue", "Arial";
    font-size: 13px;
    color: #1A1A1A;
}

QMainWindow, QWidget#centralWidget {
    background-color: #FFFFFF;
}

/* ---------- Groupes ---------- */
QGroupBox {
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    margin-top: 10px;
    padding: 8px 8px 8px 8px;
    background-color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: #1A1A1A;
}

/* ---------- Boutons ---------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
    color: #1A1A1A;
}
QPushButton:hover {
    border-color: #4A90D9;
    background-color: #FAFAFA;
}
QPushButton:pressed {
    background-color: #EEEEEE;
}
QPushButton:disabled {
    color: #999999;
    border-color: #E0E0E0;
    background-color: #FAFAFA;
}
QPushButton#btnEvacuation {
    background-color: #C62828;
    color: #FFFFFF;
    border: 1px solid #B71C1C;
    font-weight: 600;
}
QPushButton#btnEvacuation:hover {
    background-color: #B71C1C;
}

/* ---------- Champs ---------- */
QLineEdit, QSpinBox, QTimeEdit, QComboBox {
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    padding: 5px 8px;
    font-size: 13px;
    background-color: #FFFFFF;
    selection-background-color: #E3F2FD;
    selection-color: #1A1A1A;
}
QLineEdit:focus, QSpinBox:focus, QTimeEdit:focus, QComboBox:focus {
    border-color: #4A90D9;
}
QLineEdit:read-only {
    background-color: #F5F5F5;
    color: #555555;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    border: 1px solid #D0D0D0;
    background-color: #FFFFFF;
    selection-background-color: #E3F2FD;
    selection-color: #1A1A1A;
}

/* ---------- Tableaux ---------- */
QTableWidget, QTableView, QListView {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    gridline-color: #E8E8E8;
    font-size: 13px;
    selection-background-color: #E3F2FD;
    selection-color: #1A1A1A;
}
QHeaderView::section {
    background-color: #F5F5F5;
    border: none;
    border-bottom: 2px solid #D0D0D0;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 12px;
    color: #555555;
}

/* ---------- Onglets ---------- */
QTabWidget::pane {
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    background-color: #FFFFFF;
    top: -1px;
}
QTabBar::tab {
    background-color: #F5F5F5;
    border: 1px solid #D0D0D0;
    border-bottom: none;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 500;
    color: #555555;
}
QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #1A1A1A;
    border-bottom: 2px solid #4A90D9;
}
QTabBar::tab:hover:!selected {
    border-color: #4A90D9;
}

/* ---------- Barres de progression ---------- */
QProgressBar {
    border: 1px solid #D0D0D0;
    border-radius: 2px;
    background-color: #F5F5F5;
    text-align: center;
    font-size: 11px;
    height: 18px;
}
QProgressBar::chunk {
    background-color: #1565C0;
    border-radius: 1px;
}

/* ---------- Badges ---------- */
QLabel#badgeCritique {
    background-color: #C62828;
    color: #FFFFFF;
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#badgeAttention {
    background-color: #F57C00;
    color: #FFFFFF;
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#badgeInfo {
    background-color: #FBC02D;
    color: #1A1A1A;
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#badgeOffline {
    background-color: #616161;
    color: #FFFFFF;
    padding: 2px 8px;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- Barre d'etat ---------- */
QFrame#statusBar {
    background-color: #F5F5F5;
    border-bottom: 1px solid #D0D0D0;
}
QFrame#statusBar QLabel {
    font-size: 12px;
    color: #555555;
}

/* ---------- Cartes salle ---------- */
QFrame#carteSalle {
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
    border-radius: 2px;
}
QFrame#carteSalle:hover {
    border-color: #4A90D9;
}
QFrame#carteSalle[enLigne="false"] {
    background-color: #F5F5F5;
}
QLabel#carteNom {
    font-size: 14px;
    font-weight: 600;
    color: #1A1A1A;
}
QLabel#carteOcc {
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 24px;
    font-weight: 700;
    color: #1A1A1A;
}
QLabel#carteDetail {
    font-size: 11px;
    color: #555555;
}
QLabel#ledCercle {
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
}

/* ---------- Reflet LCD ---------- */
QFrame#lcdMirror {
    border: 2px solid #D0D0D0;
    background-color: #1A1A1A;
    padding: 6px;
}
QFrame#lcdMirror QLabel {
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 14px;
    color: #2E7D32;
    background-color: transparent;
}

/* ---------- Scinder ---------- */
QSplitter::handle {
    background-color: #D0D0D0;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: #F5F5F5;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #D0D0D0;
    border-radius: 2px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #BDBDBD;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #F5F5F5;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #D0D0D0;
    border-radius: 2px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- Journal / logs ---------- */
QPlainTextEdit#logTexte {
    font-family: "Roboto Mono", "Consolas", "Courier New", monospace;
    font-size: 11px;
    color: #555555;
    background-color: #FFFFFF;
    border: 1px solid #D0D0D0;
}
